# Mireye API keys (round-robin). Two keys is enough; a third is optional.
MIREYE_KEY_1=
MIREYE_KEY_2=
MIREYE_KEY_3=

# OpenAI API key (brief writer only, never the predictor)
OPENAI_KEY=

# NASA FIRMS MAP_KEY (register at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Slack delivery (optional; log-only mode if unset)
SLACK_BOT_TOKEN=

# Email delivery (optional; log-only mode if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Optional: path to an out-of-process spread engine binary that speaks
# `bin inputs.json outputs.json` (see spread_service/server.py). Unset uses
# the built-in Rothermel-Huygens solver behind the same HTTP contract.
SPREAD_ENGINE_BIN=
SPREAD_SERVICE_HOST=127.0.0.1
SPREAD_SERVICE_PORT=8765

# OpenAI API key (brief writer only, never the predictor)
OPENAI_KEY=

# NASA FIRMS MAP_KEY (register at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Slack delivery (optional; log-only mode if unset)
SLACK_BOT_TOKEN=

# Email delivery (optional; log-only mode if unset)
SMTP_HOST=
SMTP_PORT=587
